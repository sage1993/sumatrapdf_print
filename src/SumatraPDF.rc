IDD_PROPSHEET_PRINT_ADVANCED DIALOGEX 0, 0, 292, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Print range",IDC_SECTION_PRINT_RANGE,7,7,278,52
    CONTROL         "&All selected pages",IDC_PRINT_RANGE_ALL,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,18,264,9
    CONTROL         "&Odd pages only",IDC_PRINT_RANGE_ODD,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,31,264,9
    CONTROL         "&Even pages only",IDC_PRINT_RANGE_EVEN,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,44,264,9
    GROUPBOX        "Page scaling",IDC_SECTION_PRINT_SCALE,7,62,278,65
    CONTROL         "&Shrink pages to printable area (if necessary)",IDC_PRINT_SCALE_SHRINK,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,74,264,9
    CONTROL         "&Fit pages to printable area",IDC_PRINT_SCALE_FIT,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,87,264,9
    CONTROL         "S&tretch pages to fill paper (ignore aspect ratio)",IDC_PRINT_SCALE_STRETCH,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,100,264,9
    CONTROL         "&Use original page sizes",IDC_PRINT_SCALE_NONE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,113,264,9
    CONTROL         "Center page hori&zontally on the paper",IDC_PRINT_CENTER_HORIZONTALLY,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,133,278,10
    CONTROL         "Choose &paper source by document page size",IDC_PRINT_PAPER_SOURCE_BY_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,146,278,10
    CONTROL         "Print each page at its &document page size (mixed sizes)",IDC_PRINT_PER_PAGE_PAPER_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,159,278,10
    LTEXT           "&Rotate printout:",IDC_PRINT_ROTATE_LABEL,7,175,72,9
    COMBOBOX        IDC_PRINT_ROTATE,82,173,90,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_PRINT_PREVIEW DIALOGEX 0, 0, 600, 368
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Print"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Printer:",IDC_STATIC,6,7,38,10
    COMBOBOX        IDC_PP_PRINTER,44,5,260,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Properties",IDC_PP_PROPERTIES,310,5,68,14
    PUSHBUTTON      "Advanced",IDC_PP_ADVANCED,382,5,68,14
    LTEXT           "Copies:",IDC_STATIC,456,8,42,9
    EDITTEXT        IDC_PP_COPIES,500,5,50,14,ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,6,24,588,1

    GROUPBOX        "Pages",IDC_STATIC,6,34,254,58
    CONTROL         "All",IDC_PP_PAGE_ALL,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,46,100,10
    CONTROL         "Current page",IDC_PP_PAGE_CURRENT,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,134,46,116,10
    CONTROL         "Pages:",IDC_PP_PAGE_RANGE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,60,58,10
    EDITTEXT        IDC_PP_PAGE_RANGE_EDIT,76,58,170,14,ES_AUTOHSCROLL | WS_TABSTOP

    GROUPBOX        "Scaling",IDC_STATIC,6,98,254,70
    CONTROL         "Fit",IDC_PP_SCALE_FIT,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,110,100,10
    CONTROL         "Actual size",IDC_PP_SCALE_ACTUAL,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,134,110,116,10
    CONTROL         "Shrink",IDC_PP_SCALE_SHRINK,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,124,100,10
    CONTROL         "Custom:",IDC_PP_SCALE_CUSTOM,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,134,124,58,10
    EDITTEXT        IDC_PP_SCALE_CUSTOM_EDIT,194,122,50,14,ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "Choose paper source by document page size",IDC_PP_PAPER_SOURCE_BY_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,146,236,10

    CONTROL         "Duplex",IDC_PP_DUPLEX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,174,100,10
    GROUPBOX        "Orientation",IDC_STATIC,6,188,254,42
    CONTROL         "Auto",IDC_PP_ORIENT_AUTO,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,202,80,10
    CONTROL         "Portrait",IDC_PP_ORIENT_PORTRAIT,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,114,202,80,10
    CONTROL         "Landscape",IDC_PP_ORIENT_LANDSCAPE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,210,202,44,10

    GROUPBOX        "Preview",IDC_STATIC,268,34,326,298
    CONTROL         "",IDC_PP_PREVIEW,"Static",SS_OWNERDRAW | WS_BORDER,276,54,310,240
    PUSHBUTTON      "<",IDC_PP_PREV,376,300,26,16
    LTEXT           "1 / 1",IDC_PP_PAGE_INDICATOR,408,303,72,10,SS_CENTER
    PUSHBUTTON      ">",IDC_PP_NEXT,486,300,26,16

    GROUPBOX        "Information",IDC_STATIC,6,238,254,94
    LTEXT           "Document:",IDC_STATIC,14,250,52,10
    LTEXT           "-",IDC_PP_DOC_SIZE,68,250,68,10
    LTEXT           "Paper:",IDC_STATIC,14,266,52,10
    LTEXT           "-",IDC_PP_PAPER_SIZE,68,266,68,10
    LTEXT           "Printable:",IDC_STATIC,14,282,52,10
    LTEXT           "-",IDC_PP_PRINTABLE_SIZE,68,282,68,10
    LTEXT           "-",IDC_PP_EFFECTIVE_SCALE,142,250,110,10
    LTEXT           "-",IDC_PP_OUTPUT_SIZE,142,266,110,10
    LTEXT           "-",IDC_PP_CLIPPING,142,282,110,28

    PUSHBUTTON      "Page Setup",IDC_PP_PAGE_SETUP,6,344,74,16
    PUSHBUTTON      "System Print...",IDC_PP_SYSTEM_PRINT,86,344,84,16
    DEFPUSHBUTTON   "Print",IDC_PP_PRINT,510,344,84,16
    PUSHBUTTON      "Cancel",IDCANCEL,420,344,84,16
END
IDD_PRINT_PAGE_SETUP DIALOGEX 0, 0, 300, 142
